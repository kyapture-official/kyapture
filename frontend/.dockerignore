# Keep the image build hermetic: the build must use only the source tree plus
# explicit build args (see docker-compose.yml), never host-local artifacts.
# In particular .env.local (host `npm run dev` settings) must not be baked
# into the production bundle.
node_modules
dist
dist-*
.env
.env.*
*.local
vite.config.js.timestamp-*
cypress
