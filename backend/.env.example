# ─── Django Core Settings ────────────────────────────────────────────────────
SECRET_KEY=django-insecure-your-secret-key-here
DJANGO_SETTINGS_MODULE=config.settings.development

# ─── PostgreSQL Database Settings ────────────────────────────────────────────
DB_HOST=localhost
DB_NAME=Kyapture_DB
DB_USER=photoDelivery
DB_PASSWORD=enter_your_postgres_password_here
DB_PORT=5432

# ─── Redis & Celery Message Broker Settings ──────────────────────────────────
# Mapped to match your dynamic docker-compose local network routing
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# ─── AWS S3 Storage Settings (Optional in local development fallback) ────────
# Paste these once S3 hosting is purchased by the client
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_STORAGE_BUCKET_NAME=your_s3_bucket_name_here
AWS_S3_REGION_NAME=us-east-1