*.py[cod]
*$py.class

# Local Secret Configurations
.env
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Database backups and SQLite engines
db.sqlite3
db.sqlite3-journal
*.sql
*.dump

# Local Multi-Tenant Photographer Uploads (Never commit client images to Git)
backend/media/
backend/staticfiles/
backend/static/

# Frontend Development Packages & Compiled Builds
node_modules/
frontend/dist/
frontend/.svelte-kit/
